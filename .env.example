# Šablona proměnných prostředí — jen NÁZVY a popisy, nikdy hodnoty.
# Lokálně: zkopírovat do .env.local a vyplnit. Produkce a preview: Vercel →
# Project → Settings → Environment Variables. Úplný přehled (k čemu, co je
# tajné, co je nastavené): docs/PROVOZ.md „Proměnné prostředí" a
# docs/PROVOZ.md kap. 5.2.
#
# PŘEPÍNAČE (*_ENABLED) platí jen s hodnotou přesně `true`; prázdná nebo
# chybějící proměnná = funkce vypnutá (cron route vrací 404 a nic nedělá).

# ── Supabase (povinné) ─────────────────────────────────────────────────────
# Supabase → Project Settings → API. Nové názvy (nastavuje integrace
# Supabase–Vercel) mají přednost před starými NEXT_PUBLIC_* / SERVICE_ROLE.
# Adresa projektu (https://<ref>.supabase.co).
SUPABASE_URL=
# Veřejný (publishable) klíč.
SUPABASE_PUBLISHABLE_KEY=
# TAJNÉ: klíč se service rolí, obchází RLS. Jen server, nikdy do prohlížeče.
SUPABASE_SECRET_KEY=
# Staré názvy (záloha, když nové chybí):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Dvoufázové přihlášení (2FA) ────────────────────────────────────────────
# 2FA je vynucené VŽDY, i když proměnná chybí (lib/auth/mfa.ts). Nouzový
# vypínač: jen hodnota `false` vypne AAL2 bránu v proxy.ts a requireUser
# (databáze AAL2 vynucuje dál) a každé vyhodnocení zapíše varování do logu.
# Běžně NENASTAVOVAT. Postup a rizika: docs/PROVOZ.md bod 8.
# MFA_ENFORCED=

# ── Cloudflare Turnstile (ochrana přihlášení, volitelné) ───────────────────
# Cloudflare → Turnstile → widget → Sitekey / Secret key. Bez nich se widget
# nevykreslí a přihlášení Turnstile nekontroluje.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TAJNÉ.
TURNSTILE_SECRET_KEY=

# ── Veřejný web: formuláře, retence (balík P6) ─────────────────────────────
# Formuláře webu (/api/web/poptavka, /api/web/objednavka) používají stejné
# klíče Turnstile výše; bez TURNSTILE_SECRET_KEY nic nepřijmou.
# Příjem poptávek a objednávek z webu. VÝCHOZÍ VYPNUTO (503): zapnout až po
# podpisu smlouvy o zpracování a zveřejnění informačního textu. Hodnota `true`.
WEB_INTAKE_ENABLED=
# Slib „nabídka do pár minut" na webu. Jen když agent standardní nabídky
# opravdu odesílá sám (schválená mapa, L4). Jinak web uvádí reálnou lhůtu.
NEXT_PUBLIC_WEB_INSTANT_OFFER_CLAIM=
# Denní retence údajů z webu (/api/cron/web-retention, RPC 0106). Hodnota `true`.
WEB_RETENTION_ENABLED=

# ── Veřejná adresa aplikace ────────────────────────────────────────────────
# https adresa (produkce: https://www.mummiesdaddies.com) pro OAuth metadata
# a redirecty konektoru (lib/oauth.ts), odkazy v e-mailu přehledu a adresu
# webhooku pošty. Bez ní se OAuth URL odvozuje z požadavku; přehled e-mailem
# bez ní skončí chybou konfigurace.
APP_URL=

# Hosty, na které se smí vracet OAuth kód konektoru (čárkou, bez schématu).
# Přidává k výchozím claude.ai a claude.com; loopback (localhost, 127.0.0.1)
# je povolen vždy. Registrace klienta s jiným hostem končí chybou 400.
OAUTH_REDIRECT_HOSTS=

# ── Cron a webhook ─────────────────────────────────────────────────────────
# TAJNÉ: heslo cronů (Authorization: Bearer …) pro všechny /api/cron/*;
# odvozuje se z něj i clientState webhooku pošty (HMAC).
CRON_SECRET=

# ── Anthropic (čtení PDF nabídek) ──────────────────────────────────────────
# TAJNÉ. Bez něj import nabídky z PDF skončí chybou.
ANTHROPIC_API_KEY=
# Volitelně: denní strop čtení PDF modelem na člověka (import nabídky i hromadný
# import zakázek; celé číslo 1–1000, výchozí 40). Počítadlo je v audit_event.
AI_PDF_DAILY_LIMIT=

# ── Microsoft Entra ID (Outlook: kalendář, pošta, odesílání přehledu) ──────
# Azure portál → App registrations → aplikace.
MS_CLIENT_ID=
# TAJNÉ.
MS_CLIENT_SECRET=
# Tenant id, nebo 'common' pro víc tenantů / osobní účty (výchozí 'common').
MS_TENANT_ID=

# POZOR — nejčastější příčina chyby AADSTS50011 při připojování Outlooku.
# Tato adresa musí být VYPLNĚNÁ ZDE a zároveň zaregistrovaná v Azure
# (App registration → Authentication → Web → Redirect URIs), znak po znaku.
#
# Když ji necháte prázdnou, aplikace si ji dopočítá z adresy, ze které přišel
# požadavek. Na produkci to vyjde, ale každé náhledové nasazení z Vercelu má
# jinou adresu, kterou Azure nezná — připojení pak spadne a z chyby není
# poznat proč. Proto ji nastavte výslovně.
#
# produkce:  https://www.mummiesdaddies.com/api/ms/callback
# lokálně:   http://localhost:3200/api/ms/callback
MS_REDIRECT_URI=

# Metadata dokumentů ze SharePointu/OneDrivu/Teams (plan kap. 8). 'true' =
# Cockpit při připojení Outlooku žádá navíc delegované Files.Read.All a při
# vložení odkazu do dokumentů dodávky načte název, kanonický odkaz a poslední
# změnu (nikdy obsah). Po zapnutí musí každý člen v Nastavení kliknout
# „Znovu připojit". Prázdné/cokoli jiného = vypnuto (odkaz se ukládá, jak je).
GRAPH_FILES_SCOPE_ENABLED=

# Denní kontrola dokumentů dodávek v SharePointu (verze, změna od schválení,
# zmizel, bez přístupu). VÝCHOZÍ VYPNUTO: jen přesně 'true' ji zapne. Běží v denním
# cronu /api/cron/follow-ups, čte jen metadata (obsah souborů nikdy). Potřebuje
# migraci 0094, GRAPH_FILES_SCOPE_ENABLED=true a člena s uděleným Files.Read.All
# (Nastavení → Znovu připojit). docs/PROVOZ.md, bod 3e.
SHAREPOINT_DOC_SYNC_ENABLED=
# uuid člena, jehož Outlook kontrola používá; prázdné = OUTLOOK_MAIL_SYNC_MEMBER_ID.
SHAREPOINT_DOC_SYNC_MEMBER_ID=

# Kontrola naplánovaných schůzek v Outlooku (posun, zrušení) v denním cronu
# /api/cron/follow-ups (běží jen se zapnutým FOLLOWUP_WATCH_ENABLED=true).
# Vypne ji 'false' (docs/PROVOZ.md, bod 3d).
# Stačí stávající Calendars.ReadWrite, nic nového v Entra.
# CALENDAR_SYNC_ENABLED=false

# ── Pošta z Outlooku (sync, webhook, schopnosti nad poštou) ────────────────
# Přepínač: denní sync pošty (/api/cron/outlook-mail).
OUTLOOK_MAIL_SYNC_ENABLED=
# team_member.id (uuid) člena, jehož schránka se čte.
OUTLOOK_MAIL_SYNC_MEMBER_ID=
# Okno prvního načtení pošty ve dnech (výchozí 120; 0 = bez omezení, celá historie).
MAIL_SYNC_INITIAL_DAYS=
# Přepínač: okamžité notifikace Graphu (/api/ms/notifications); platí jen
# spolu s OUTLOOK_MAIL_SYNC_ENABLED=true.
OUTLOOK_MAIL_WEBHOOK_ENABLED=
# Přepínač: příchozí e-mail → návrh pracovního případu (migrace 0067).
CAPABILITY_MAIL_TO_CASE_ENABLED=
# Přepínač: automatické založení poptávky z nespárované pošty (migrace 0081,
# docs/PROVOZ.md).
CAPABILITY_AUTO_INTAKE_ENABLED=
# Volitelné: denní limit automatických založení (celé číslo 1–200); jinak
# platí výchozí z konfigurace firmy (core/tenant.ts).
AUTO_INTAKE_DAILY_LIMIT=
# Přepínač: pošta s obsahem. Zprávy, které člověk PŘESUNE v Outlooku do složky
# „Cockpit", se přečtou včetně těla (uloží se jen předmět, úryvek do 300 znaků
# a názvy příloh); ostatní pošta zůstává metadata. Výchozí vypnuto; vyžaduje
# migraci 0091 a běží s denní synchronizací (docs/PROVOZ.md).
MAIL_CONTENT_INTAKE_ENABLED=
# Volitelné: název složky v Outlooku (výchozí „Cockpit").
MAIL_CONTENT_FOLDER=
# Přepínač: smí Cockpit chybějící složku sám založit? Výchozí vypnuto (složku
# založ v Outlooku); založení by chtělo oprávnění Mail.ReadWrite, které Cockpit
# nežádá, takže dnes skončí hláškou.
MAIL_CONTENT_FOLDER_CREATE=
# Přepínač: krátké AI shrnutí vybrané zprávy (model dostane předmět a text bez
# adres; potřebuje ANTHROPIC_API_KEY). Výchozí vypnuto, rozhodují pravidla.
MAIL_CONTENT_AI_ENABLED=
# Nabídka v PDF příloze zprávy ze složky Cockpit -> návrh zakázky s cenou ke
# potvrzení ve frontě „Pošta k zařazení" (docs/PROVOZ.md). PDF se
# neukládá. Jen `true`; výchozí vypnuto. Závisí na MAIL_CONTENT_INTAKE_ENABLED,
# ANTHROPIC_API_KEY a migraci 0099. Stačí oprávnění Mail.Read.
MAIL_OFFER_ATTACHMENT_ENABLED=
# Volitelně další slova (čárkami oddělená), podle kterých název PDF nebo předmět
# značí nabídku (výchozí: nabídka, offer, proposal, quote, kalkulace, rozpočet).
MAIL_OFFER_ATTACHMENT_KEYWORDS=

# ── Další automaty ─────────────────────────────────────────────────────────
# Přepínač: denní dávka doplňování IČO a sídla z ARESu (/api/cron/ares-enrich).
ARES_ENRICH_ENABLED=
# Přepínač: denní follow-up hlídač (/api/cron/follow-ups).
FOLLOWUP_WATCH_ENABLED=

# ── iDoklad (čtení faktur a úhrad, migrace 0092, docs/PROVOZ.md) ───────────
# Přepínač: denní čtení vydaných faktur a úhrad z iDokladu (běží v cronu
# /api/cron/ares-enrich). Výchozí VYPNUTO; nikdy nic nezapisuje do iDokladu.
IDOKLAD_SYNC_ENABLED=
# Client ID API klienta z iDokladu (Nastavení → Aplikace → API → Generovat).
IDOKLAD_CLIENT_ID=
# TAJNÉ: Client Secret téhož API klienta. Jen server, nikdy do prohlížeče ani do logu.
IDOKLAD_CLIENT_SECRET=
# Volitelné: kolik dní zpět se čte (celé číslo 1–365; výchozí 90).
IDOKLAD_SYNC_DAYS=

# ── Přehled e-mailem (/api/cron/weekly-digest) ─────────────────────────────
# Přepínač odesílání.
DIGEST_SEND_ENABLED=
# `delegated` (výchozí i když chybí: z připojeného Outlooku člena) nebo `app`
# (servisní schránka s vlastní app-only registrací).
DIGEST_SEND_MODE=
# Příjemci: čárkami oddělené adresy, jen @mummiesdaddies.com, max. 20; při odeslání
# se navíc zúží na členy s obchodní rolí (vedeni, obchodnik).
DIGEST_RECIPIENTS=
# Jen `delegated`: team_member.id odesílatele (jinak OUTLOOK_MAIL_SYNC_MEMBER_ID).
DIGEST_SENDER_MEMBER_ID=
# Jen `app`: odesílací schránka (výchozí z konfigurace firmy); v `delegated` se nečte.
DIGEST_SENDER=
# Jen `app`: SAMOSTATNÁ registrace v Entra (ne MS_CLIENT_*). Secret je TAJNÝ.
MS_APP_TENANT_ID=
MS_APP_CLIENT_ID=
MS_APP_CLIENT_SECRET=

# ── Jen skripty a GitHub Actions (secrets v GitHubu, ne ve Vercelu) ────────
# Aplikace je nečte; uvedeno kvůli úplnosti (docs/PROVOZ.md bod 1).
# SUPABASE_DB_URL=         TAJNÉ: připojení k produkční DB (migrace, záloha)
# STAGING_DB_URL=          TAJNÉ: připojení ke stagingu (migrace nanečisto)
# BACKUP_STORAGE_URL=      trezor záloh (jiný Supabase projekt než produkce)
# BACKUP_STORAGE_KEY=      TAJNÉ: klíč k trezoru záloh
# BACKUP_PASSPHRASE=       TAJNÉ: šifrování záloh
# MIGRATE_DB_TLS_INSECURE= jen lokální zkouška migrací proti jinému Postgresu

# Nastavuje platforma, neměnit: NODE_ENV, VERCEL, VERCEL_ENV (CSP: toolbar
# vercel.live jen na preview, upgrade-insecure-requests jen na Vercelu).

# ── Lokální vývoj ──────────────────────────────────────────────────────────
# Jen když je node_modules symlink mimo složku projektu: kořen pro Turbopack
# (next.config.ts). Na Vercelu NENASTAVOVAT.
# TURBOPACK_ROOT=

# ── Follow-up cadence (balík P4) ───────────────────────────────────────────
# Připomínky neodpovězených nabídek přes agent_outbox; běží v cronu
# /api/cron/follow-ups za hlídačem (FOLLOWUP_WATCH_ENABLED). Hodnota `true`.
FOLLOWUP_CADENCE_ENABLED=
