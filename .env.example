# Proměnné prostředí — vzor. Generuje se ze scripts/env-catalog.mjs
# (node scripts/setup-check.mjs --write-env-example); ručně needitovat.
# Postup a tabulka: docs/NASAZENI.md. Lokálně zkopírovat do .env.local.
# Všechny přepínače *_ENABLED jsou ve výchozím stavu vypnuté.

# --- Supabase ---
# Adresa projektu Supabase (https://<ref>.supabase.co) (povinná)
SUPABASE_URL=
# Veřejný klíč (sb_publishable_…) pro přihlášení a dotazy s RLS (povinná)
SUPABASE_PUBLISHABLE_KEY=
# Servisní klíč (sb_secret_…), obchází RLS — jen server, crony, RPC webu (povinná)
SUPABASE_SECRET_KEY=
# Starší název SUPABASE_URL (záložní čtení) — nenastavovat (volitelná)
# NEXT_PUBLIC_SUPABASE_URL=
# Starší název publishable klíče (záložní čtení) — nenastavovat (volitelná)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Starší název servisního klíče (záložní čtení) — nenastavovat (volitelná)
# SUPABASE_SERVICE_ROLE_KEY=

# --- Migrace (GitHub) ---
# Připojovací řetězec produkční DB pro scripts/migrate.mjs (Session pooler) (volitelná)
# SUPABASE_DB_URL=
# Připojovací řetězec stagingu (volitelná)
# STAGING_DB_URL=
# Ref(y) produkčního projektu, na které staging nesmí ukazovat (volitelná)
# PRODUCTION_PROJECT_REFS=
# Jen lokální zkouška proti jinému Postgresu (=1 neověřuje TLS). Nikdy proti Supabase (volitelná)
# MIGRATE_DB_TLS_INSECURE=

# --- Aplikace ---
# Veřejná adresa (https://www.mummiesdaddies.com) — odkazy v e-mailech, OAuth (povinná)
APP_URL=
# Bearer tajemství, kterým Vercel Cron volá /api/cron/* (povinná)
CRON_SECRET=
# false vypne povinné dvoufázové přihlášení — v produkci NIKDY (volitelná; výchozí: zapnuto)
# MFA_ENFORCED=
# Další povolené hosty pro OAuth klienty MCP (čárkou) (volitelná)
# OAUTH_REDIRECT_HOSTS=
# Ověření Cloudflare Turnstile (přihlášení, formuláře webu /api/web/*) (povinná)
TURNSTILE_SECRET_KEY=
# Veřejný klíč widgetu Turnstile v prohlížeči (povinná)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Provoz a alarm ---
# true zapne cron /api/cron/ops-alarm (alarm do 15 minut) (volitelná; výchozí: vypnuto)
# OPS_ALARM_ENABLED=
# HTTPS webhook, který alarm přepošle e-mailem / SMS správci (povinná při OPS_ALARM_ENABLED=true)
# ALERT_WEBHOOK_URL=
# Za jak dlouho připomenout trvající problém (15–1440) (volitelná; výchozí: 180)
# OPS_ALARM_REPEAT_MINUTES=
# Úlohy hlídané na „přestala běžet“ (název:minuty) (volitelná; výchozí: inquiry-agent:20,agent-outbox:20)
# OPS_EXPECTED_JOBS=
# Bearer pro detail /api/health (bez něj jen ok/degraded/down) (volitelná)
# HEALTH_TOKEN=

# --- Gmail ---
# OAuth klient interní aplikace v Google Cloud projektu klienta (čtení i odesílání) (povinná při INQUIRY_AGENT_ENABLED=true)
# GMAIL_OAUTH_CLIENT_ID=
# Tajemství OAuth klienta (povinná při INQUIRY_AGENT_ENABLED=true)
# GMAIL_OAUTH_CLIENT_SECRET=
# Refresh tokeny schránek jako JSON {"adresa schránky": "refresh token"} (rozsahy gmail.readonly + gmail.send) (povinná při INQUIRY_AGENT_ENABLED=true)
# GMAIL_REFRESH_TOKENS=
# Jen pro setup-check: refresh token jedné schránky k ověření (do Vercelu nedávat) (volitelná; výchozí: první z GMAIL_REFRESH_TOKENS)
# GMAIL_CHECK_REFRESH_TOKEN=

# --- Agent ---
# true zapne cron /api/cron/inquiry-agent (čtení pošty a rozhodnutí) (volitelná; výchozí: vypnuto)
# INQUIRY_AGENT_ENABLED=
# Čtené schránky (adresy čárkou); každá musí mít token v GMAIL_REFRESH_TOKENS (povinná při INQUIRY_AGENT_ENABLED=true)
# INQUIRY_AGENT_MAILBOXES=
# true zapne cron /api/cron/agent-outbox (odesílání přes Gmail; jen schválené zprávy) (volitelná; výchozí: vypnuto)
# AGENT_OUTBOX_ENABLED=
# true dovolí odeslání bez člověka (navíc L4 v Cockpitu a schválená mapa) (volitelná; výchozí: vypnuto)
# AGENT_AUTOSEND_ENABLED=
# Klíč Anthropic API (čtení poptávek, PDF nabídek) (povinná při INQUIRY_AGENT_ENABLED=true)
# ANTHROPIC_API_KEY=
# Denní strop čtení PDF modelem (import nabídek) (volitelná; výchozí: 40)
# AI_PDF_DAILY_LIMIT=
# true zapne geokódování místa akce (vzdálenost pro dopravu, Mapy.com) (volitelná; výchozí: vypnuto)
# GEO_ENABLED=
# Klíč Mapy.com API (geokódování adresy akce) (povinná při GEO_ENABLED=true)
# MAPY_API_KEY=
# true zapne připomínky neodpovězených nabídek přes odchozí frontu (cron /api/cron/follow-ups) (volitelná; výchozí: vypnuto)
# FOLLOWUP_CADENCE_ENABLED=

# --- Outbound agent ---
# true zapne cron /api/cron/outbound-agent (signály, leady, oslovení) (volitelná; výchozí: vypnuto)
# OUTBOUND_AGENT_ENABLED=
# true dovolí oslovení bez člověka (jen stávající zákazníci a doložený souhlas) (volitelná; výchozí: vypnuto)
# OUTBOUND_AUTOSEND_ENABLED=
# Podpis odkazu na odhlášení (min. 32 znaků); bez něj žádné oslovení neodejde (povinná při OUTBOUND_AGENT_ENABLED=true)
# OUTBOUND_UNSUBSCRIBE_SECRET=
# Zdroj signálů ARES (nové firmy) (volitelná; výchozí: vypnuto)
# OUTBOUND_ARES_ENABLED=
# Zdroj signálů z RSS/iCal kalendářů akcí (volitelná; výchozí: vypnuto)
# OUTBOUND_FEEDS_ENABLED=
# Zdroj signálů z inzerátů práce (volitelná; výchozí: vypnuto)
# OUTBOUND_JOBS_ENABLED=
# Zdroj signálů z veřejných zakázek (ISVZ) (volitelná; výchozí: vypnuto)
# VVZ_ENABLED=
# Adresa JSON exportu otevřených dat veřejných zakázek (povinná při VVZ_ENABLED=true)
# VVZ_OPEN_DATA_URL=

# --- Veřejný web ---
# true zapne příjem poptávek a objednávek z webu (/api/web/*); bez něj 503 (volitelná; výchozí: vypnuto)
# WEB_INTAKE_ENABLED=
# true zapne denní retenci údajů z webu (/api/cron/web-retention) (volitelná; výchozí: vypnuto)
# WEB_RETENTION_ENABLED=
# true = web slibuje nabídku do pár minut (jen když agent opravdu odesílá sám) (volitelná; výchozí: vypnuto)
# NEXT_PUBLIC_WEB_INSTANT_OFFER_CLAIM=

# --- Původní (Microsoft 365) — nepoužívat ---
# true zpřístupní trasy /api/ms/* (Outlook); klient má Google Workspace (volitelná; výchozí: vypnuto)
# MS_GRAPH_ENABLED=
# Sync pošty přes Microsoft Graph — klient má Google Workspace, nechat vypnuté (volitelná; výchozí: vypnuto)
# OUTLOOK_MAIL_SYNC_ENABLED=
# Člen týmu pro Graph sync (volitelná)
# OUTLOOK_MAIL_SYNC_MEMBER_ID=
# Webhook Graph (volitelná; výchozí: vypnuto)
# OUTLOOK_MAIL_WEBHOOK_ENABLED=
# Registrace aplikace Entra ID (volitelná)
# MS_CLIENT_ID=
# Tajemství Entra ID (volitelná)
# MS_CLIENT_SECRET=
# Tenant Entra ID (volitelná; výchozí: common)
# MS_TENANT_ID=
# Callback Graph OAuth (volitelná)
# MS_REDIRECT_URI=
# Aplikační registrace pro přehled e-mailem (režim app) (volitelná)
# MS_APP_CLIENT_ID=
# Tajemství aplikační registrace (volitelná)
# MS_APP_CLIENT_SECRET=
# Tenant aplikační registrace (volitelná)
# MS_APP_TENANT_ID=
# Rozsah Files.Read.All (volitelná; výchozí: vypnuto)
# GRAPH_FILES_SCOPE_ENABLED=
# Kontrola dokumentů v SharePointu (volitelná; výchozí: vypnuto)
# SHAREPOINT_DOC_SYNC_ENABLED=
# Člen pro SharePoint (volitelná)
# SHAREPOINT_DOC_SYNC_MEMBER_ID=
# Kontrola schůzek v Outlooku (false = vypnout) (volitelná; výchozí: zapnuto s follow-upy)
# CALENDAR_SYNC_ENABLED=
# Přehled e-mailem přes Graph (volitelná; výchozí: vypnuto)
# DIGEST_SEND_ENABLED=
# Režim odeslání přehledu (volitelná; výchozí: delegated)
# DIGEST_SEND_MODE=
# Příjemci přehledu (jen firemní adresy) (volitelná)
# DIGEST_RECIPIENTS=
# Odesílatel přehledu (režim app) (volitelná)
# DIGEST_SENDER=
# Člen, jehož tokenem se přehled posílá (volitelná)
# DIGEST_SENDER_MEMBER_ID=
# Čtení obsahu pošty ze složky Outlooku (volitelná; výchozí: vypnuto)
# MAIL_CONTENT_INTAKE_ENABLED=
# Model nad obsahem pošty (volitelná; výchozí: vypnuto)
# MAIL_CONTENT_AI_ENABLED=
# Název složky Outlooku (volitelná)
# MAIL_CONTENT_FOLDER=
# Založit složku automaticky (volitelná; výchozí: vypnuto)
# MAIL_CONTENT_FOLDER_CREATE=
# Čtení PDF nabídek z odeslané pošty (volitelná; výchozí: vypnuto)
# MAIL_OFFER_ATTACHMENT_ENABLED=
# Klíčová slova příloh nabídek (volitelná)
# MAIL_OFFER_ATTACHMENT_KEYWORDS=
# Okno prvního načtení pošty (volitelná; výchozí: 120)
# MAIL_SYNC_INITIAL_DAYS=
# Automatický příjem z pošty (Graph) (volitelná; výchozí: vypnuto)
# CAPABILITY_AUTO_INTAKE_ENABLED=
# Denní limit automatického příjmu (volitelná; výchozí: z konfigurace)
# AUTO_INTAKE_DAILY_LIMIT=
# Případ z pošty (volitelná; výchozí: vypnuto)
# CAPABILITY_MAIL_TO_CASE_ENABLED=

# --- Ostatní úlohy ---
# true zapne denní cron /api/cron/follow-ups (hlídač follow-upů, vypršení schválení) (volitelná; výchozí: vypnuto)
# FOLLOWUP_WATCH_ENABLED=
# true zapne denní doplňování IČO z ARES (veřejný registr, bez klíče) (volitelná; výchozí: vypnuto)
# ARES_ENRICH_ENABLED=
# Sync iDokladu (modul finance je vypnutý) (volitelná; výchozí: vypnuto)
# IDOKLAD_SYNC_ENABLED=
# iDoklad API klient (povinná při IDOKLAD_SYNC_ENABLED=true)
# IDOKLAD_CLIENT_ID=
# iDoklad API tajemství (povinná při IDOKLAD_SYNC_ENABLED=true)
# IDOKLAD_CLIENT_SECRET=
# Jen uzavřený náhled: heslo prohlížeče na celou aplikaci ve tvaru uživatel:heslo; v ostrém provozu nenastavovat (volitelná)
# PREVIEW_BASIC_AUTH=
# Jen vývoj: kořen Turbopacku při běhu z git worktree (volitelná)
# TURBOPACK_ROOT=
# Kolik dní zpět číst faktury (volitelná; výchozí: 90)
# IDOKLAD_SYNC_DAYS=

# --- Nastavuje platforma (Vercel, Node, GitHub Actions) — nevyplňovat ---
# NODE_ENV, VERCEL, VERCEL_ENV, GITHUB_OUTPUT, GITHUB_STEP_SUMMARY
