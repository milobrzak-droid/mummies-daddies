# Šablona proměnných prostředí (jen NÁZVY, žádné hodnoty). Zkopírujte do
# .env.local a doplňte. Všechny přepínače *_ENABLED jsou ve výchozím stavu
# vypnuté; zapínají se jen hodnotou 'true'. Popis: docs/PROVOZ.md.
# (Šablonu doplnil balík P7 — v základu chyběla a test/env-example.test.ts padal.)

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplikace a zabezpečení ---------------------------------------------------
APP_URL=
CRON_SECRET=
OAUTH_REDIRECT_HOSTS=
# 2FA je povinné; vypnout jen lokálně (nikdy v produkci):
# MFA_ENFORCED=
# Nastavuje platforma: NODE_ENV, VERCEL, VERCEL_ENV

# --- Veřejný web (Turnstile) ----------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Model (Anthropic) ------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_PDF_DAILY_LIMIT=

# --- Pošta, kalendář a dokumenty (Microsoft Graph — u této firmy se nepoužívá) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=
MS_APP_CLIENT_ID=
MS_APP_CLIENT_SECRET=
MS_APP_TENANT_ID=
GRAPH_FILES_SCOPE_ENABLED=
OUTLOOK_MAIL_SYNC_ENABLED=
OUTLOOK_MAIL_SYNC_MEMBER_ID=
OUTLOOK_MAIL_WEBHOOK_ENABLED=
MAIL_SYNC_INITIAL_DAYS=
MAIL_CONTENT_INTAKE_ENABLED=
MAIL_CONTENT_AI_ENABLED=
MAIL_CONTENT_FOLDER=
MAIL_CONTENT_FOLDER_CREATE=
MAIL_OFFER_ATTACHMENT_ENABLED=
MAIL_OFFER_ATTACHMENT_KEYWORDS=
CALENDAR_SYNC_ENABLED=
SHAREPOINT_DOC_SYNC_ENABLED=
SHAREPOINT_DOC_SYNC_MEMBER_ID=

# --- Schopnosti a úlohy -------------------------------------------------------------
CAPABILITY_MAIL_TO_CASE_ENABLED=
CAPABILITY_AUTO_INTAKE_ENABLED=
AUTO_INTAKE_DAILY_LIMIT=
FOLLOWUP_WATCH_ENABLED=
ARES_ENRICH_ENABLED=
IDOKLAD_SYNC_DAYS=
DIGEST_SEND_ENABLED=
DIGEST_SEND_MODE=
DIGEST_SENDER=
DIGEST_SENDER_MEMBER_ID=
DIGEST_RECIPIENTS=

# --- Outbound agent (P7, docs/OUTBOUND.md) -------------------------------------------
# Hlavní přepínač: bez 'true' vrací /api/cron/outbound-agent 404 a nic se neděje.
OUTBOUND_AGENT_ENABLED=
# Samostatné odeslání (JEN stávajícím zákazníkům a kontaktům s doloženým souhlasem).
OUTBOUND_AUTOSEND_ENABLED=
# Tajemství podpisu odkazu na odhlášení (min. 32 znaků). Bez něj žádný e-mail nevznikne.
OUTBOUND_UNSUBSCRIBE_SECRET=
# Zdroje signálů (každý zvlášť):
OUTBOUND_ARES_ENABLED=
OUTBOUND_FEEDS_ENABLED=
OUTBOUND_JOBS_ENABLED=
VVZ_ENABLED=
# Adresa JSON exportu otevřených dat veřejných zakázek (Portál ISVZ). OVĚŘIT.
VVZ_OPEN_DATA_URL=
