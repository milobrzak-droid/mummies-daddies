  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:release",
  "crons": [
    { "path": "/api/cron/outlook-mail", "schedule": "0 4 * * *" },
    { "path": "/api/cron/weekly-digest", "schedule": "0 5 * * *" },
    { "path": "/api/cron/ares-enrich", "schedule": "0 4 * * *" },
    { "path": "/api/cron/follow-ups", "schedule": "0 6 * * *" },
    { "path": "/api/cron/inquiry-agent", "schedule": "15 4 * * *" },
    { "path": "/api/cron/agent-outbox", "schedule": "30 6 * * *" },
    { "path": "/api/cron/outbound-agent", "schedule": "45 8 * * 1-5" }
  ]
}
